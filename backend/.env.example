DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/srs_diagram_platform
SECRET_KEY=change-this-development-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
EMAIL_DELIVERY_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@srs-platform.local
SMTP_FROM_NAME=SRS Diagram Platform
SMTP_USE_TLS=true
EMAIL_VERIFICATION_CODE_EXPIRE_MINUTES=10
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_MODELS=gpt-5.6,gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna,gpt-5.5,gpt-5.5-2026-04-23,gpt-5.4,gpt-5.4-2026-03-05,gpt-5.4-pro,gpt-5.4-mini,gpt-5.2,gpt-4.1,gpt-4.1-mini,gpt-4.1-nano,gpt-4o,gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODELS=claude-fable-5,claude-opus-5,claude-sonnet-5,claude-haiku-4-5-20251001,claude-opus-4-8,claude-opus-4-7,claude-opus-4-6,claude-sonnet-4-6
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-pro-preview,gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-2.5-pro,gemini-2.5-flash,gemini-2.5-flash-lite
OPENAI_TEMPERATURE=0
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=0
# Local AI via an Ollama server (no API key). In Docker this is http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_MODELS=llama3.2,llama3.1,qwen2.5,qwen2.5-coder,mistral,phi3
OLLAMA_TEMPERATURE=0
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=5m
AI_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-production-secret
SRSGEN_BASE_MODEL=Qwen/Qwen1.5-1.8B-Chat
SRSGEN_ARTIFACT_PATH=model_artifacts/srsgen-qwen1.5
SRSGEN_LOAD_IN_4BIT=true
SRSGEN_MAX_NEW_TOKENS=2048
SRSGEN_TEMPERATURE=0
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=admin
SUPER_ADMIN_FULL_NAME=Platform Super Admin



BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
